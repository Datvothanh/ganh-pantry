# Shopify Storefront API. Leave the first two empty to use the built-in mock catalogue.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Set to 1 to serve the dev-only routes (/dev/cart/harness.html, /dev/composite.html) in a
# production build. Read at runtime. Leave unset in production.
GANH_DEV_ROUTES=

# Set to "mock" to force the built-in mock catalogue and cart even when the Shopify variables are
# set. `npm run build:mock` and the e2e checks use it so tests never touch a real store.
GANH_COMMERCE=
